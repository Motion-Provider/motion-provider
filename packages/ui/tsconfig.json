{
  "extends": "@motion/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "declaration": true,
    "noEmit": false,
    "emitDeclarationOnly": false,
