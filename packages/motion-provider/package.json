{
  "name": "motion-provider",
  "version": "1.0.0",
  "description": "Preset-driven animation engine for the web and React, powered by the WAAPI.",
  "author": {
    "name": "Burak Bilen",
    "email": "hello@burakdev.com",
    "url": "https://burakdev.com"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node ../../tests/browser/run.mjs",
    "test:compiler": "node scripts/check-compiler.mjs",
    "size": "node ../../scripts/src/size.mjs",
    "demo": "node scripts/demo.mjs",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run test:compiler && npm run size"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
