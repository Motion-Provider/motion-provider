{
	"name": "motion-provider",
	"version": "1.0.0",
	"description": "Preset-driven React animations powered by the WAAPI.",
	"author": {
		"name": "Burak Bilen",
		"email": "hello@burakdev.com",
		"url": "https://burakdev.com"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		},
		"./getAnimation": {
			"types": "./dist/getAnimation.d.ts",
			"import": "./dist/getAnimation.js"
		},
		"./engine": {
			"types": "./dist/engine/index.d.ts",
			"import": "./dist/engine/index.js"
		},
		"./lite": {
			"types": "./dist/components/motion.d.ts",
			"import": "./dist/components/motion.js"
		},
		"./hooks": {
			"types": "./dist/hooks.d.ts",
			"import": "./dist/hooks.js"
		},
		"./presets": {
			"types": "./dist/presets/index.d.ts",
			"import": "./dist/presets/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"import": "./dist/utils.js"
		},
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"import": "./dist/components/*.js"
		},
		"./constants/*": {
			"types": "./dist/constants/*.d.ts",
			"import": "./dist/constants/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"docs"
	],
	"engines": {
		"node": ">=20"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0"
	},
	"dependencies": {},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "npm run build && node --test tests/*.test.mjs",
		"test:browser": "node tests/browser/run.mjs",
		"test:compiler": "node scripts/check-compiler.mjs",
		"size": "node scripts/size.mjs",
		"demo": "node scripts/demo.mjs",
		"prepack": "npm run build",
		"check": "npm run typecheck && npm test && npm run test:compiler && npm run size"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"esbuild": "0.28.0"
	},
	"license": "MIT"
}
