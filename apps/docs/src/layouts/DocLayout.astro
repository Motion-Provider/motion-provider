---
import type { MarkdownHeading } from "astro";
import { cn } from "@/lib/cn";
import NavAstro from "../components/Nav.astro";
import NavTree from "../components/NavTree.astro";
import Toc from "../components/Toc.astro";
import type { NavGroup, NavItem } from "../lib/docs";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  nav: readonly NavGroup[];
  currentId: string;
  headings: readonly MarkdownHeading[];
  prev?: NavItem | undefined;
  next?: NavItem | undefined;
}

const { title, description, nav, currentId, headings, prev, next } =
  Astro.props;
---

<BaseLayout title={`${title} · Motion Provider Docs`} description={description}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-60 focus:rounded focus:bg-surface focus:px-3 focus:py-2"
  >
    Skip to content
  </a>
  <NavAstro />
  <div
    class="grid min-h-[calc(100dvh-var(--nav-h))] w-full grid-cols-1 items-start lg:grid-cols-[var(--sidebar-w)_minmax(0,1fr)] xl:grid-cols-[var(--sidebar-w)_minmax(0,1fr)_var(--toc-w)]"
  >
    <div>
      <div
        id="docs-backdrop"
        aria-hidden="true"
        hidden
        class="fixed inset-x-0 bottom-0 top-(--nav-h) z-30 bg-black/50 backdrop-blur-[1px] lg:hidden"
      ></div>

      <aside
        id="docs-sidebar"
        aria-label="Documentation navigation"
        data-open="false"
        class={cn(
          "-translate-x-full motion-reduce:transition-none",
          "docs-sidebar bg-surface/20 invisible fixed left-0 top-(--nav-h) z-40",
          "h-[calc(100dvh-var(--nav-h))] w-(--sidebar-w) max-w-[85vw] min-w-min",
          "overflow-y-scroll overscroll-contain border-r border-border",
          "px-4 py-6 transition-[transform,visibility] duration-200",
          "data-[open=true]:visible data-[open=true]:translate-x-0 lg:visible lg:sticky lg:top-(--nav-h)",
          "lg:z-auto lg:h-[calc(100dvh-var(--nav-h))] lg:w-auto lg:max-w-none lg:translate-x-0 lg:transition-none tracking-tight",
        )}
      >
        <NavTree groups={nav} currentId={currentId} />
      </aside>
    </div>

    <main
      id="main"
      tabindex="-1"
      class="mx-auto w-full min-w-0 max-w-3xl px-5 py-10 pb-16 sm:px-8 lg:px-10"
    >
      <article data-pagefind-body class="docs-prose prose max-w-none">
        <h1>{title}</h1>
        <slot />
      </article>

      <nav
        aria-label="Pagination"
        class="mt-12 flex justify-between gap-4 border-t border-border pt-6 text-sm"
      >
        {
          prev ? (
            <a href={prev.href} rel="prev" class="hover:text-accent">
              {"<"} {prev.title}
            </a>
          ) : (
            <span />
          )
        }

        {
          next && (
            <a href={next.href} rel="next" class="hover:text-accent">
              {next.title} {">"}
            </a>
          )
        }
      </nav>
    </main>

    <aside
      aria-label="Page contents"
      class="mr-auto hidden min-w-0 self-start border-l border-border xl:sticky xl:top-(--nav-h) xl:block xl:px-5 xl:py-10"
    >
      <Toc headings={headings} />
    </aside>
  </div>
</BaseLayout>

<script>
  const sidebar = document.getElementById("docs-sidebar");
  const backdrop = document.getElementById("docs-backdrop");
  const toggle = document.getElementById("docs-nav-toggle");
  const sidebarScrollKey = "motion-provider:docs-sidebar-scroll";

  if (sidebar && toggle) {
    const desktop = window.matchMedia("(min-width: 64rem)");

    const saveSidebarPosition = (): void => {
      try {
        sessionStorage.setItem(sidebarScrollKey, String(sidebar.scrollTop));
      } catch {
        // Storage can be unavailable in restricted browsing contexts.
      }
    };

    const restoreSidebarPosition = (): void => {
      let savedPosition: number | undefined;

      try {
        const storedPosition = sessionStorage.getItem(sidebarScrollKey);

        if (storedPosition !== null) {
          const position = Number(storedPosition);

          if (Number.isFinite(position) && position >= 0) {
            savedPosition = position;
          }
        }
      } catch {
        // Fall back to centering the active link when storage is unavailable.
      }

      const navigationType = performance.getEntriesByType("navigation")[0]
        ?.type;

      requestAnimationFrame(() => {
        if (savedPosition !== undefined) {
          sidebar.scrollTo({ top: savedPosition, behavior: "instant" });

          if (navigationType === "reload") {
            return;
          }
        }

        const activeLink = sidebar.querySelector<HTMLAnchorElement>(
          'a[aria-current="page"]',
        );

        if (!activeLink) {
          return;
        }

        const sidebarRect = sidebar.getBoundingClientRect();
        const activeRect = activeLink.getBoundingClientRect();
        const isActiveVisible =
          activeRect.top >= sidebarRect.top &&
          activeRect.bottom <= sidebarRect.bottom;

        if (savedPosition !== undefined && isActiveVisible) {
          return;
        }

        const centeredTop =
          sidebar.scrollTop +
          activeRect.top -
          sidebarRect.top -
          (sidebar.clientHeight - activeRect.height) / 2;
        const maxScrollTop = sidebar.scrollHeight - sidebar.clientHeight;

        sidebar.scrollTo({
          top: Math.max(0, Math.min(centeredTop, maxScrollTop)),
          behavior: "instant",
        });
      });
    };

    restoreSidebarPosition();

    let saveFrame = 0;

    sidebar.addEventListener(
      "scroll",
      () => {
        if (saveFrame) {
          return;
        }

        saveFrame = requestAnimationFrame(() => {
          saveFrame = 0;
          saveSidebarPosition();
        });
      },
      { passive: true },
    );

    window.addEventListener("pagehide", saveSidebarPosition);

    const setOpen = (open: boolean): void => {
      const shouldOpen = open && !desktop.matches;

      sidebar.dataset.open = String(shouldOpen);

      if (backdrop) {
        backdrop.hidden = !shouldOpen;
      }

      toggle.setAttribute("aria-expanded", String(shouldOpen));

      document.documentElement.classList.toggle(
        "overflow-hidden",
        shouldOpen,
      );

      if (shouldOpen) {
        const activeLink =
          sidebar.querySelector<HTMLElement>('a[aria-current="page"]') ??
          sidebar.querySelector<HTMLElement>("a[href]");

        activeLink?.focus({ preventScroll: true });
      }
    };

    const closeMenu = (restoreFocus = false): void => {
      setOpen(false);

      if (restoreFocus && !desktop.matches) {
        toggle.focus();
      }
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    backdrop?.addEventListener("click", () => {
      closeMenu();
    });

    sidebar.addEventListener("click", (event) => {
      if (
        !desktop.matches &&
        event.target instanceof Element &&
        event.target.closest("a")
      ) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (desktop.matches || sidebar.dataset.open !== "true") {
        return;
      }

      if (event.key === "Escape") {
        event.preventDefault();
        closeMenu(true);
        return;
      }

      if (event.key === "Tab") {
        const focusable = sidebar.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        );

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });

    desktop.addEventListener("change", () => {
      closeMenu();
    });
  }
</script>
