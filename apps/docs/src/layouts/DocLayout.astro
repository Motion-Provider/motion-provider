---
import type { MarkdownHeading } from "astro";
import { cn } from "@/lib/cn";
import NavAstro from "../components/Nav.astro";
import NavTree from "../components/NavTree.astro";
import Toc from "../components/Toc.astro";
import type { NavGroup, NavItem } from "../lib/docs";
import BaseLayout from "./BaseLayout.astro";

interface BaseProps {
  title: string;
  description: string;
  nav: readonly NavGroup[];
  currentId: string;
}

interface DocProps extends BaseProps {
  landing?: false | undefined;
  headings: readonly MarkdownHeading[];
  prev?: NavItem | undefined;
  next?: NavItem | undefined;
}

interface LandingProps extends BaseProps {
  landing: true;
}

type Props = DocProps | LandingProps;

const props = Astro.props;
const { title, description, nav, currentId } = props;
const doc = props.landing ? undefined : props;
---

<BaseLayout
  title={doc ? `${title} · Motion Provider Docs` : title}
  description={description}
>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-60 focus:rounded focus:bg-surface focus:px-3 focus:py-2"
  >
    Skip to content
  </a>
  <NavAstro />
  <div
    class={cn(
      "grid min-h-[calc(100dvh-var(--nav-h))] w-full grid-cols-1 items-start lg:grid-cols-[var(--sidebar-w)_minmax(0,1fr)]",
      doc && "xl:grid-cols-[var(--sidebar-w)_minmax(0,1fr)_var(--toc-w)]",
    )}
  >
    <div class="sticky top-(--nav-h) left-0">
      <div
        id="docs-backdrop"
        aria-hidden="true"
        hidden
        class="fixed inset-x-0 bottom-0 top-(--nav-h) z-30 bg-black/50 backdrop-blur-[1px] lg:hidden"
      ></div>

      <aside
        id="docs-sidebar"
        aria-label="Documentation navigation"
        data-open="false"
        class={cn(
          "-translate-x-full motion-reduce:transition-none",
          "docs-sidebar bg-surface/20 invisible fixed left-0 top-(--nav-h) z-40",
          "h-[calc(100dvh-var(--nav-h))] w-(--sidebar-w) max-w-[85vw] min-w-min",
          "overflow-y-scroll overscroll-contain border-r border-border",
          "px-4 py-6 transition-[transform,visibility] duration-200",
          "data-[open=true]:visible data-[open=true]:translate-x-0 lg:visible lg:sticky lg:top-(--nav-h)",
          "lg:z-auto lg:h-[calc(100dvh-var(--nav-h))] lg:w-auto lg:max-w-none lg:translate-x-0 lg:transition-none tracking-tight",
        )}
      >
        <NavTree groups={nav} currentId={currentId} />
      </aside>
    </div>

    <main
      id="main"
      class={cn(
        "mx-auto w-full min-w-0",
        doc && "max-w-3xl px-5 py-10 pb-16 sm:px-8 lg:px-10",
      )}
      transition:animate="fade"
    >
      {
        doc ? (
          <>
            <article data-pagefind-body class="docs-prose prose max-w-none">
              <h1>{title}</h1>
              <slot />
            </article>

            <nav
              aria-label="Pagination"
              class="mt-12 flex justify-between gap-4 border-t border-border pt-6 text-sm"
            >
              {doc.prev ? (
                <a href={doc.prev.href} rel="prev" class="hover:text-accent">
                  {"<"} {doc.prev.title}
                </a>
              ) : (
                <span />
              )}

              {doc.next && (
                <a href={doc.next.href} rel="next" class="hover:text-accent">
                  {doc.next.title} {">"}
                </a>
              )}
            </nav>
          </>
        ) : (
          <slot />
        )
      }
    </main>

    {
      doc && (
        <aside
          aria-label="Page contents"
          class={cn(
            "mr-auto hidden min-w-min self-start xl:sticky xl:top-24",
            "xl:block xl:mt-[calc(var(--nav-h)+2rem)]] xl:max-h-[calc(50dvh-var(--nav-h))]",
            "py-2 overflow-hidden ",
          )}
        >
          <Toc headings={doc.headings} />
        </aside>
      )
    }
  </div>
</BaseLayout>