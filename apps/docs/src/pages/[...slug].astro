---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import ImageMdx from "@/components/mdx/ImageMdx.astro";
import Callout from "../components/mdx/Callout.astro";
import Code from "../components/mdx/Code.astro";
import CodeCopy from "../components/mdx/CodeCopy.astro";
import Details from "../components/mdx/Details.astro";
import Summary from "../components/mdx/Summary.astro";
import Registry from "../components/Registry.astro";
import DocLayout from "../layouts/DocLayout.astro";
import {
  buildIndex,
  type DocEntry,
  type DocsIndex,
  getDocs,
  getNeighbors,
} from "../lib/docs";

interface Props {
  entry: DocEntry;
  index: DocsIndex;
}

export const getStaticPaths = (async () => {
  const docs = await getDocs();
  const index = buildIndex(docs);
  return docs.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry, index },
    cacheKey: entry.id,
  }));
}) satisfies GetStaticPaths;

const mdxComponents = {
  Callout,
  Registry,
  code: Code,
  details: Details,
  summary: Summary,
  img: ImageMdx,
};
const { entry, index } = Astro.props;
const { Content, headings } = await render(entry);
const { prev, next } = getNeighbors(index.flat, entry.id);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  nav={index.nav}
  currentId={entry.id}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content components={mdxComponents} />
  <CodeCopy />
</DocLayout>