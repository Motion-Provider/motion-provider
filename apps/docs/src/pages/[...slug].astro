---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import ImageMdx from "@/components/mdx/ImageMdx.astro";
import Callout from "../components/mdx/Callout.astro";
import Code from "../components/mdx/Code.astro";
import CodeCopy from "../components/mdx/CodeCopy.astro";
import Details from "../components/mdx/Details.astro";
import Summary from "../components/mdx/Summary.astro";
import Registry from "../components/Registry.astro";
import DocLayout from "../layouts/DocLayout.astro";
import {
  buildIndex,
  type DocEntry,
  type DocsIndex,
  getDocs,
  getNeighbors,
  getSection,
  type NavSection,
} from "../lib/docs";

interface Props {
  entry: DocEntry;
  index: DocsIndex;
  section: NavSection;
}

export const getStaticPaths = (async () => {
  const docs = await getDocs();

  const indexes: Record<NavSection, DocsIndex> = {
    docs: buildIndex(docs, "docs"),
    api: buildIndex(docs, "api"),
    learn: buildIndex(docs, "learn"),
  };

  return docs.map((entry) => {
    const section = getSection(entry.id);

    return {
      params: { slug: entry.id === "index" ? undefined : entry.id },

      props: { entry, index: indexes[section], section },

      cacheKey: entry.id,
    };
  });
}) satisfies GetStaticPaths;

const mdxComponents = {
  Callout,
  Registry,
  code: Code,
  details: Details,
  summary: Summary,
  img: ImageMdx,
};

const { entry, index, section } = Astro.props;

const { Content, headings } = await render(entry);

const { prev, next } = getNeighbors(index.flat, entry.id);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  section={section}
  nav={index.nav}
  currentId={entry.id}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content components={mdxComponents} />
  <CodeCopy />
</DocLayout>
