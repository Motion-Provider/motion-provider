---
import { LucideArrowUpRight } from "@lucide/astro";
import { WordmarkImage } from "@motion/ui";
import ExploreCard from "@/components/ExploreCard.astro";
import FrameworkCard from "@/components/FrameworkCard.astro";
import Registry from "@/components/Registry.astro";
import exploreData from "@/data/explore.data";
import frameworksData from "@/data/frameworks.data";
import learnData from "@/data/learnCards.data";
import DocLayout from "@/layouts/DocLayout.astro";
import { cn } from "@/lib/cn";
import { buildIndex, getDocs } from "@/lib/docs";

const index = buildIndex(await getDocs(), "docs");

const sections = index.nav.flatMap((group) => {
  const first = group.items[0];
  return group.label && first
    ? [{ label: group.label, href: first.href, count: group.items.length }]
    : [];
});
---

<DocLayout
  landing
  title="Motion Provider"
  description="An open-source React animation library for rapid development."
  section="docs"
  nav={index.nav}
  currentId=""
>
  <div class="mx-auto w-full max-w-5xl px-3 py-20 sm:px-8 lg:px-10 lg:py-24 z-0">
    <section aria-labelledby="home-title" class="text-center flex items-center-safe justify-center-safe flex-col relative">
      <p class="mb-4 text-xs font-semibold uppercase tracking-wide text-accent">
        Documentation
      </p>
      <WordmarkImage 
        client:load 
        controller={{
          configView: {
            once: false,
            amount: 0.5
          },
        }}
        img="/app-wordmark.webp" 
        className="w-full md:h-72 h-34 md:-mt-20 -mt-8"
      />
      <p class="md:max-w-xl max-w-xs md:text-base text-sm text-muted text-pretty md:-mt-16 -mt-8">
        Motion Provider is an open-source Preset-driven animation engine for the web and React, powered by
        the Web Animations API.
      </p> 
    </section>
    <section aria-label="explore" id="explore" class="flex items-start justify-center gap-3 mt-12 max-w-full md:flex-row flex-col">
      {exploreData.map((item) => <ExploreCard {...item} />)}
    </section>
    <section 
      aria-label="explore-framework" 
      id="frameworks" 
      class="mt-12"
    >
      <h2 class="text-muted text-xs font-semibold uppercase tracking-wide">Explore By Frontend Framework</h2>
      <ul aria-label="explore" id="explore" class="flex items-start justify-center mt-4 max-w-full flex-wrap">
        {frameworksData.map((item) => <FrameworkCard {...item} />)}
      </ul>  
    </section>
    <section 
      aria-label="learn" 
      id="learn" 
      class="@container mt-20"
    >
      <h2 id="learn-title" class="text-muted text-xs font-semibold uppercase tracking-wide">practice with real world use cases</h2>
      <ul aria-labelledby="learn-title" class="mt-4 grid grid-cols-1 gap-3 @min-[40rem]:grid-cols-2">
        {learnData.map((item) => (
          <li class="min-w-0 relative">
            <a href={item.href} aria-label={item.title}>
              <button class={cn("absolute right-4 cursor-pointer hover:text-foreground text-muted z-50",
                item?.withButton ? "bottom-4" : "top-4"
              )}>
                <LucideArrowUpRight class="size-5"/>
              </button>
            </a>
            <Registry {...item} slug={`learn/${item.slug}`} inGrid />
          </li>
        ))}
      </ul>
    </section>
    {
      sections.length > 0 && (
        <section aria-labelledby="home-sections" class="mt-16">
          <h2
            id="home-sections"
            class="mb-4 text-xs font-semibold uppercase tracking-wide text-muted"
          >
            Discover
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {sections.map((section) => (
              <li>
                <a
                  href={section.href}
                  class="block h-full rounded-lg border border-border bg-surface p-5 transition-colors hover:border-accent"
                  data-astro-prefetch
                >
                  <span class="block font-medium">{section.label}</span>
                  <span class="mt-1 block text-sm text-muted">
                    {section.count} {section.count === 1 ? "page" : "pages"}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</DocLayout>
