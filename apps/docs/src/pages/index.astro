---
import { WordmarkImage } from "@motion/ui";
import ExploreCard from "@/components/ExploreCard.astro";
import exploreData from "@/data/explore.data";
import DocLayout from "@/layouts/DocLayout.astro";
import { buildIndex, getDocs } from "@/lib/docs";
import { Image } from "astro:assets";

const index = buildIndex(await getDocs());

const sections = index.nav.flatMap((group) => {
  const first = group.items[0];
  return group.label && first
    ? [{ label: group.label, href: first.href, count: group.items.length }]
    : [];
});
---

<DocLayout
  landing
  title="Motion Provider"
  description="An open-source React animation library for rapid development."
  nav={index.nav}
  currentId=""
>
  <div class="mx-auto w-full max-w-5xl px-3 py-20 sm:px-8 lg:px-10 lg:py-24 z-0">
    <section aria-labelledby="home-title" class="text-center flex items-center-safe justify-center-safe flex-col relative">
      <p class="mb-4 text-xs font-semibold uppercase tracking-wide text-accent">
        Documentation
      </p>
      <WordmarkImage 
        client:load 
        controller={{
          configView: {
            once: false,
            amount: 0.5
          },
        }}
        img="/app-wordmark.webp" 
        className="w-full md:h-72 h-34 md:-mt-20 -mt-8"
      />
      <p class="md:max-w-xl max-w-xs md:text-base text-sm text-muted text-pretty md:-mt-16 -mt-8">
        Motion Provider is an open-source Preset-driven animation engine for the web and React, powered by
        the Web Animations API.
      </p> 
    </section>
    <section aria-label="explore" id="explore" class="flex items-start justify-center gap-3 mt-12 max-w-full md:flex-row flex-col">
      {exploreData.map((item) => <ExploreCard {...item} />)}
    </section>
    <section 
      aria-label="explore-framework" 
      id="frameworks" 
      class="flex flex-wrap"
    >
    <Image src="/tanstack.svg" width={80} height={80} alt="Frameworks" class="size-24" />
    </section>
  </div>
</DocLayout>