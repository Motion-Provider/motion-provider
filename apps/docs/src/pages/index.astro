---
import {
  LucideAnchor,
  LucideArrowUpRight,
  LucideBellRing,
  LucideBookOpen,
  LucideLibrary,
  LucideSlidersHorizontal,
} from "@lucide/astro";
import { WordmarkImage } from "@motion/ui";
import DiscoverCard from "@/components/DiscoverCard.astro";
import ExploreCard from "@/components/ExploreCard.astro";
import FrameworkCard from "@/components/FrameworkCard.astro";
import Registry from "@/components/Registry.astro";
import exploreData from "@/data/explore.data";
import frameworksData from "@/data/frameworks.data";
import { home } from "@/data/home.data";
import learnItems from "@/data/learnCards.data";
import DocLayout from "@/layouts/DocLayout.astro";
import { cn } from "@/lib/cn";
import { buildIndex, docHref, getDocs } from "@/lib/docs";

const index = buildIndex(await getDocs(), "docs");
const learnCards = learnItems.map((item) => ({
  ...item,
  href:
    "draft" in item && !import.meta.env.DEV ? undefined : docHref(item.docId),
}));

const discoverIcons: Partial<Record<string, typeof LucideBookOpen>> = {
  hooks: LucideAnchor,
  "event-handlers": LucideBellRing,
  controllers: LucideSlidersHorizontal,
  registry: LucideLibrary,
};

const sections = index.nav.flatMap((group) => {
  const first = group.items[0];
  return group.label && first
    ? [
        {
          label: group.label,
          href: first.href,
          count: group.items.length,
          icon: discoverIcons[group.key] ?? LucideBookOpen,
        },
      ]
    : [];
});
---

<DocLayout
  landing
  title={home.title}
  description="An open-source React animation library for rapid development."
  section="docs"
  nav={index.nav}
  currentId=""
>
  <div class="mx-auto w-full max-w-5xl px-3 py-20 sm:px-8 lg:px-10 lg:py-24 z-0">
    <section aria-labelledby="home-title" class="text-center flex items-center-safe justify-center-safe flex-col relative">
      <p class="mb-4 text-xs font-semibold uppercase tracking-wide text-accent">
        Documentation
      </p>
      <WordmarkImage 
        client:load 
        controller={{
          configView: {
            once: false,
            amount: 0.5
          },
        }}
        img="/app-wordmark.webp" 
        className="w-full md:h-72 h-34 md:-mt-20 -mt-8"
      />
      <p class="md:max-w-xl max-w-xs md:text-base text-sm text-muted text-pretty md:-mt-16 -mt-8">
        Motion Provider is an open-source Preset-driven animation engine for the web and React, powered by
        the Web Animations API.
      </p> 
    </section>
    <section aria-label="explore" id="explore" class="flex items-start justify-center gap-3 mt-12 max-w-full md:flex-row flex-col">
      {exploreData.map((item) => <ExploreCard {...item} />)}
    </section>
    <section 
      aria-label="explore-framework" 
      id="frameworks" 
      class="mt-12"
    >
      <h2 id={home.headings.frameworks.slug} class="text-muted text-xs font-semibold uppercase tracking-wide">{home.headings.frameworks.text}</h2>
      <ul aria-label="explore" id="explore" class="flex items-start justify-center mt-4 max-w-full flex-wrap">
        {frameworksData.map((item) => <FrameworkCard {...item} />)}
      </ul>  
    </section>
    <section 
      aria-label="learn" 
      id="learn" 
      class="@container mt-20"
    >
      <h2 id={home.headings.learn.slug} class="text-muted text-xs font-semibold uppercase tracking-wide">{home.headings.learn.text}</h2>
      <ul aria-labelledby={home.headings.learn.slug} class="mt-4 grid grid-cols-1 gap-3 @min-[40rem]:grid-cols-2">
        {learnCards.map((item) => (
          <li class:list={["min-w-0 relative", item.slug === "cas-4" && "@min-[40rem]:col-span-2"]}>
            {item.href && (
              <a href={item.href} aria-label={item.title} class={cn("absolute right-4 cursor-pointer hover:text-foreground text-muted z-50",
                item?.withButton ? "bottom-4" : "top-4"
              )}>
                <LucideArrowUpRight class="size-5"/>
              </a>
            )}
            <Registry {...item} inGrid />
          </li>
        ))}
      </ul>
    </section>
    {
      sections.length > 0 && (
        <section aria-labelledby={home.headings.discover.slug} class="mt-16">
          <h2
            id={home.headings.discover.slug}
            class="mb-4 text-xs font-semibold uppercase tracking-wide text-muted"
          >
            {home.headings.discover.text}
          </h2>
          <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            {sections.map((section) => <DiscoverCard {...section} />)}
          </ul>
        </section>
      )
    }
  </div>
</DocLayout>
