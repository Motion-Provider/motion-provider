---
import { Image } from "astro:assets";
import SandboxLayout from "@/layouts/SandboxLayout.astro";
import type { WrapperProps } from "@/lib/sandboxTypes";
import Loader from "../assets/loader.svg";
import Sandbox from "./Sandbox.tsx";

type Props = WrapperProps;

const { slug, title } = Astro.props;
---

<SandboxLayout title={title}>
    <Sandbox slug={slug} client:visible>
        <div
            slot="fallback"
            class="flex h-80 items-center justify-center"
            role="status"
            aria-label="Loading demo"
        >
        <Image
            src={Loader}
            alt="Component Loader"
            height={48}
            width={48}
            class="size-10 animate-spin motion-reduce:animate-none"
        />
        </div>
    </Sandbox>
</SandboxLayout>