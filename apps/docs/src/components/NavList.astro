---
import { cn } from "@/lib/cn";
import type { NavSection } from "@/lib/docs";

export type NavItem = {
  key: NavSection;
  label: string;
  href: string;
  external?: boolean;
};

export const navItems: readonly NavItem[] = [
  { key: "docs", label: "Docs", href: "/" },
  { key: "api", label: "API", href: "/api/overview" },
  { key: "learn", label: "Learn", href: "/learn" },
];

interface Props {
  section: NavSection;
  className?: string;
}

const { section, className } = Astro.props;
---


 <div class={cn("lg:h-full h-12 shrink-0 items-center md:mb-0 mb-4 gap-0.75 lg:pl-4", className)}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.key === section ? "page" : undefined}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
            class={cn(
              "relative inline-flex h-full items-center px-3.25 text-[13px] leading-none transition-colors duration-150 after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-[#eb5600] after:transition-transform after:duration-150",
              item.key === section
                ? "font-medium text-accent after:scale-x-100"
                : "text-[#a5a198] after:scale-x-0 hover:text-white",
            )}
          >
            {item.label}
          </a>
        ))
      }
</div>