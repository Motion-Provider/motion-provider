---
import { Image } from "astro:assets";
import Logo from "@assets/brand-lockup.png";
---

<header
  class="sticky top-0 z-50 h-(--nav-h) w-full border-b border-border bg-background/80 backdrop-blur"
>
  <nav aria-label="Primary" class="flex h-full items-center gap-2 px-4">
    <button
      id="docs-nav-toggle"
      type="button"
      aria-controls="docs-sidebar"
      aria-expanded="false"
      aria-label="Toggle documentation menu"
      class="-ml-2 inline-flex size-10 items-center justify-center rounded text-muted hover:bg-surface-secondary hover:text-foreground lg:hidden"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <a href="/" class="flex shrink-0 items-center" aria-label="Motion Provider home">
      <Image
        src={Logo}
        alt="Motion Provider"
        width={120}
        height={40}
        loading="eager"
        class="h-10 w-auto"
      />
    </a>
  </nav>
</header>