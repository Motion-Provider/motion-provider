---
import { Image } from "astro:assets";
import Logo from "@assets/brand-lockup.png";
---

<header class="sticky top-0 z-50 h-(--nav-h) w-full border-b border-border bg-background/80 backdrop-blur">
  <nav
    aria-label="Primary"
    class="mx-auto flex h-full w-full max-w-360 items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <a href="/" class="flex shrink-0 items-center" aria-label="Motion Provider home">
      <Image
        src={Logo}
        alt="Motion Provider"
        width={120}
        height={40}
        loading="eager"
        class="h-10 w-auto"
      />
    </a>
  </nav>
</header>