---
import { Image } from "astro:assets";
import Logo from "@assets/brand-lockup.png";

const pathname = Astro.url.pathname;
const isApi = pathname.startsWith("/api/");
const isLearn = pathname.startsWith("/getting-started/");

type NavItem = {
  label: string;
  href: string;
  active: boolean;
  external?: boolean;
};

const navItems: NavItem[] = [
  { label: "Docs", href: "/", active: !isApi && !isLearn },
  { label: "API", href: "/api/overview/", active: isApi },
  {
    label: "Learn",
    href: "/getting-started/quick-start/",
    active: isLearn,
  },
] as const;
---

<header class="sticky top-0 z-50 h-11.5 w-full border-b border-border backdrop-blur pt-0.5">
  <nav aria-label="Primary" class="relative flex h-full items-start gap-2 pl-2.75 pr-1.75 pt-0.75">
    <a href="/">
      <Image
        src={Logo}
        alt="Motion Provider Logo"
        class="shrink-0 h-9 w-27 my-auto"
        height={144}
        width={432}
      />
    </a>
    <button
      id="docs-nav-toggle"
      type="button"
      aria-controls="docs-sidebar"
      aria-expanded="false"
      aria-label="Toggle documentation menu"
      class="-ml-1 inline-flex size-9 shrink-0 items-center justify-center rounded-md text-[#a5a198] transition-colors hover:bg-white/5 hover:text-white lg:hidden"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <div class="hidden h-full shrink-0 items-center gap-0.75 lg:flex">
      {
        navItems.map((item: NavItem) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            target={item?.external ? "_blank" : undefined}
            rel={item?.external ? "noreferrer" : undefined}
            class:list={[
              "relative inline-flex h-full items-center px-[13px] text-[13px] leading-none transition-colors duration-150 after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:bg-[#eb5600] after:transition-transform after:duration-150",
              item.active
                ? "font-medium text-[#eb5600] after:scale-x-100"
                : "text-[#a5a198] after:scale-x-0 hover:text-white hover:after:scale-x-100",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <label class="absolute left-[47.15%] top-[3px] hidden h-9 w-80 max-w-[calc(100vw-2rem)] -translate-x-1/2 items-center gap-2 rounded-[10px] border border-[#2a2822] bg-transparent px-3 text-[#a5a198] transition-colors focus-within:border-[#51483a] md:flex">
      <svg
        viewBox="0 0 24 24"
        class="size-4 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="10.8" cy="10.8" r="6.3"></circle>
        <path d="m15.5 15.5 4 4"></path>
      </svg>
      <input
        id="docs-search"
        type="search"
        aria-label="Search documentation"
        placeholder="Search docs..."
        autocomplete="off"
        class="h-full min-w-0 flex-1 bg-transparent text-[13px] text-[#e9e6df] outline-none placeholder:text-[#aaa49a] [&::-webkit-search-cancel-button]:hidden"
      />
      <kbd class="inline-flex h-5 shrink-0 items-center rounded border border-[#39352c] px-1.5 font-sans text-[10px] leading-none text-[#aaa49a]">
        ⌘K
      </kbd>
    </label>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <a
        href="https://github.com/login"
        target="_blank"
        rel="noreferrer"
        class="hidden h-9 items-center rounded-full border border-[#2a2822] bg-[#1b1913] px-4 text-[13px] font-medium text-[#f0eee9] transition-colors hover:border-[#494438] hover:bg-white/[0.03] sm:inline-flex"
      >
        Github
      </a>
    </div>
  </nav>
</header>

<style is:global>
  :root {
    --nav-h: 46px;
  }
</style>

<script>
  const searchInput = document.getElementById("docs-search");

  document.addEventListener("keydown", (event) => {
    if (
      (event.metaKey || event.ctrlKey) &&
      event.key.toLowerCase() === "k"
    ) {
      event.preventDefault();
      searchInput?.focus();
    }
  });
</script>
