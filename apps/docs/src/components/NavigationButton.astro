---
import { LucideArrowLeft, LucideArrowRight } from "@lucide/astro";
import { cn } from "@/lib/cn";

interface Props {
  href: string;
  title: string;
  isNext?: boolean;
}

const { isNext, href, title } = Astro.props;

const Icon = isNext ? LucideArrowRight : LucideArrowLeft;
const rel = isNext ? "next" : "prev";
---


<a
  href={href} 
  rel={rel}
  class={cn("hover:text-accent flex gap-2 items-center justify-center", !isNext && "flex-row-reverse")}
>
  <span>{title}</span> 
  <Icon class="size-4"/>
</a>
