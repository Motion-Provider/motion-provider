---
import type { NavGroup } from "../lib/docs";

interface Props {
  groups: readonly NavGroup[];
  currentId: string;
}

const { groups, currentId } = Astro.props;
const filteredGroups = groups.filter((g) => g.label);
---

<nav aria-label="Documentation" class="relative">
  <ul class="space-y-6">
    {
      filteredGroups.map((group) => (
        <li>
          {group.label && (
            <p class="mb-2 px-2 text-xs font-semibold uppercase tracking-wide text-muted">
              {group.label}
            </p>
          )}
          <ul class="space-y-1">
            {group.items.map((item) => (
              <li title={item.title}>
                <a
                  href={item.href}
                  aria-current={item.id === currentId ? "page" : undefined}
                  class="block truncate rounded-md px-2 py-1 text-sm hover:text-accent transition-colors duration-150 aria-[current=page]:bg-surface aria-[current=page]:font-medium aria-[current=page]:text-accent"
                  data-astro-prefetch
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</nav>