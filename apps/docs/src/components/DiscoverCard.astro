---
import { LucideArrowUpRight } from "@lucide/astro";
import type BookOpen from "@lucide/astro/icons/book-open";

interface Props {
  label: string;
  href: string;
  count: number;
  icon: typeof BookOpen;
}

const { label, href, count, icon: Icon } = Astro.props;
---

<li class="min-w-0">
  <a
    href={href}
    class="discover-card flex h-full items-start gap-3 rounded-xl border p-4 text-foreground transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    data-astro-prefetch
  >
    <span class="discover-icon grid size-9 shrink-0 place-items-center rounded-lg">
      <Icon aria-hidden="true" class="size-4" />
    </span>
    <span class="min-w-0 flex-1">
      <span class="block font-medium">{label}</span>
      <span class="mt-1 block text-sm text-muted">
        {count} {count === 1 ? "page" : "pages"}
      </span>
    </span>
    <LucideArrowUpRight aria-hidden="true" class="text-muted size-4 shrink-0" />
  </a>
</li>

<style>
  li {
    --discover-accent: #38bdf8;
  }

  li:nth-child(3n + 2) {
    --discover-accent: #a78bfa;
  }

  li:nth-child(3n) {
    --discover-accent: #34d399;
  }

  .discover-card {
    background-color: color-mix(in srgb, var(--discover-accent) 2.7%, var(--color-surface));

    border-color: color-mix(in srgb, var(--discover-accent) 7.2%, var(--color-border));
  }

  .discover-card:hover,
  .discover-card:focus-visible {
    background-color: color-mix(in srgb, var(--discover-accent) 4.8%, var(--color-surface));

    border-color: color-mix(in srgb, var(--discover-accent) 30%, var(--color-border));
  }

  .discover-icon {
    background-color: color-mix(in srgb, var(--color-accent) 5.4%, var(--color-surface));

    color: color-mix(in srgb, var(--color-accent) 70%, var(--color-foreground));
  }

  .discover-arrow {
    color: color-mix(in srgb, var(--discover-accent) 70%, var(--color-foreground));
  }
</style>
