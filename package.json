{
  "name": "motion-provider-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "clean": "node scripts/src/clean.mjs",
    "clean:all": "node scripts/src/clean.mjs --dist --lock",
    "reinstall": "npm run clean:all && npm install && npm run build -w motion-provider"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "esbuild": "^0.28.2",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/*",
    "tests/*"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
